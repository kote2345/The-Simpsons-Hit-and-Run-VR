#version 450
#extension GL_GOOGLE_include_directive : require
const float PI=3.14159265359;
#include "../libs/pure3d/pddi/vulkan/shaders/pbr_brdf.glsl"
layout(local_size_x=64) in;
layout(std430,binding=0) buffer Results { vec4 result[]; } outputData;
void main() {
    uint id=gl_GlobalInvocationID.x;
    float roughness=mix(0.089,1.0,float(id%8u)/7.0);
    float noV=mix(0.05,1.0,float(id/8u)/7.0);
    vec3 N=vec3(0,0,1),V=vec3(sqrt(1-noV*noV),0,noV);
    float energy=0.0;
    float alpha=roughness*roughness,a2=alpha*alpha;
    // Integrate the production GLSL BRDF in a uniform white environment.
    // Importance-sample GGX, independently of the analytic compensation fit.
    for(uint i=0u;i<8192u;++i) {
        float x=(float(i)+0.5)/8192.0;
        float y=float(bitfieldReverse(i))*2.3283064365386963e-10;
        float cosTheta=sqrt((1-y)/(1+(a2-1)*y));
        float sinTheta=sqrt(max(0.0,1-cosTheta*cosTheta));
        vec3 H=vec3(cos(2*PI*x)*sinTheta,sin(2*PI*x)*sinTheta,cosTheta);
        float voH=dot(V,H);
        if(voH<=0.0) continue;
        vec3 L=2*voH*H-V;
        float denominator=1-H.z*H.z+H.z*H.z*a2;
        float distribution=a2/(PI*denominator*denominator);
        float pdf=distribution*H.z/(4*voH);
        energy+=pbrDirectBrdf(N,V,L,vec3(1),1.0,roughness,0.0).x/max(pdf,1e-12);
    }
    energy/=8192.0;
    vec3 ibl=pbrEnvironmentReflectance(vec3(1),environmentBrdfApproximation(roughness,noV));
    vec3 blocked=pbrDirectBrdf(N,V,vec3(0,0,-1),vec3(1),0.0,roughness,0.0);
    vec3 highlight=pbrDirectBrdf(N,V,reflect(-V,N),vec3(0.5),0.0,roughness,0.00465);
    outputData.result[id]=vec4(energy,ibl.x,length(blocked),highlight.x);
}
